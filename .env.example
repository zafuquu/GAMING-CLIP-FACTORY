# Optional local paths; leave blank for project-local defaults
GCF_PROJECT_ROOT=
GCF_DATA_DIR=
GCF_MEDIA_ROOT=
GCF_DATABASE_PATH=
GCF_FFMPEG_PATH=
GCF_FFPROBE_PATH=

# Local render engine: remotion (recommended) or ffmpeg (fallback).
# On Windows, start.bat installs the Remotion runtime and runs its synthetic smoke test when needed.
GCF_RENDER_ENGINE=remotion
GCF_NODE_PATH=
GCF_REMOTION_SCRIPT_PATH=
GCF_REMOTION_TIMEOUT_SECONDS=900
# H.264 quality controls: lower CRF is higher quality/larger files; 16 + slow is the high-quality default.
# Allowed CRF: integer 12–24; x264 preset: ultrafast, superfast, veryfast, faster, fast, medium, slow, slower, veryslow, placebo.
GCF_REMOTION_CRF=16
GCF_REMOTION_X264_PRESET=slow
GCF_REMOTION_AUDIO_BITRATE=192K

# Twitch Helix metadata discovery (create an app in the Twitch developer console)
# Leave blank until configured. Discovery records URLs with UNKNOWN reuse rights.
GCF_TWITCH_CLIENT_ID=
GCF_TWITCH_CLIENT_SECRET=
# Optional user OAuth for official downloads of clips from your own/editor-authorized Twitch channels.
# Register this exact redirect URI in your Twitch developer console.
GCF_TWITCH_REDIRECT_URI=http://localhost:8766/callback

# Optional local AI transcription (install backend/requirements-ml.txt first)
GCF_ENABLE_TRANSCRIPTION=false
GCF_WHISPER_MODEL_PATH=
GCF_WHISPER_MODEL_SIZE=small
GCF_WHISPER_DEVICE=cpu
GCF_WHISPER_COMPUTE_TYPE=int8
GCF_WHISPER_ALLOW_MODEL_DOWNLOAD=false
GCF_WHISPER_CACHE_DIR=
GCF_TRANSCRIPTION_TIMEOUT_SECONDS=3600
GCF_BURN_CAPTIONS=true

# Optional public metadata-only YouTube search API key (Google Cloud Console).
# Does not authorize media reuse. API key is kept in local .env, never committed.
GCF_YOUTUBE_API_KEY=

# yt-dlp single-video downloader limits (source must pass the app's AUTHORIZED rights gate).
GCF_YTDLP_TIMEOUT_SECONDS=1800
GCF_YTDLP_MAX_BYTES=2147483648
GCF_YTDLP_MAX_DURATION_SECONDS=14400

# Multimodal gameplay highlight judgment through OpenRouter's free-model router.
# Get an OpenRouter API key and put it only in this local .env file; never commit it.
# The full video is scanned locally; only sampled candidate frames and prompt context
# are sent to OpenRouter. No local LLM/Ollama installation or model weights are needed.
# The free router chooses an available compatible multimodal model; availability,
# latency, rate limits, and judgment quality can vary. Review generated clips manually.
GCF_ENABLE_AI_JUDGING=true
GCF_OPENROUTER_API_KEY=
GCF_OPENROUTER_MODEL=openrouter/free
GCF_OPENROUTER_TIMEOUT_SECONDS=90
GCF_AI_JUDGE_SAMPLE_FRAMES=3
GCF_AI_JUDGE_MAX_CANDIDATES_PER_MEDIA=4
GCF_AI_JUDGE_BATCH_SIZE=4
# Target duration for auto-production actions exposed by the dashboard.
GCF_HIGHLIGHT_TARGET_SECONDS=30

# Bound Google API requests/uploads; uploads always start private.
GCF_GOOGLE_API_TIMEOUT_SECONDS=30
GCF_YOUTUBE_UPLOAD_TIMEOUT_SECONDS=7200
GCF_YOUTUBE_THUMBNAIL_TIMEOUT_SECONDS=180

# YouTube OAuth Desktop Client JSON must remain outside the repository.
# Run from backend: python -m app.youtube_auth
GCF_YOUTUBE_CLIENT_SECRETS=

# Both database and environment gates must be enabled before uploads can be queued.
GCF_ENABLE_YOUTUBE_UPLOADS=false

# A separate high-risk gate for scheduled public release. Uploads start private;
# the local worker rechecks rights, output hash and QC at the scheduled time.
GCF_ALLOW_SCHEDULED_PUBLIC_PUBLISHING=false


# Optional evidence-grounded script drafting through a local Ollama-compatible endpoint.
# The generated script is a draft only; owner review is required before synthesis.
GCF_ENABLE_SCRIPT_DRAFTING=false
GCF_SCRIPT_DRAFTER_BASE_URL=http://127.0.0.1:11434/api/chat
GCF_SCRIPT_DRAFTER_MODEL=llama3.1:8b
GCF_SCRIPT_DRAFTER_TIMEOUT_SECONDS=120
GCF_SCRIPT_DRAFTER_ALLOW_REMOTE=false

# Optional local narration through a separately installed Piper executable.
# Voice and engine files are not bundled or downloaded by the app. Review the
# engine license and the specific model card before commercial use.
GCF_ENABLE_NARRATION=false
GCF_PIPER_EXECUTABLE_PATH=
GCF_PIPER_MODEL_PATH=
GCF_PIPER_CONFIG_PATH=
GCF_PIPER_SPEAKER_ID=
GCF_PIPER_TIMEOUT_SECONDS=180
GCF_NARRATION_MAX_DURATION_SECONDS=60

# Storage safety. The worker pauses before claiming jobs if free space drops below
# the threshold or the capacity check fails. Recovery never auto-resumes the queue.
GCF_DISK_SAFETY_ENABLED=true
GCF_MIN_FREE_DISK_GB=3
